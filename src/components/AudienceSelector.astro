---
import IconArrow from '@components/IconArrow.astro';
import { audiences } from '@data/site';
---

<section id="audiences" class="section white" data-reveal="section">
  <div class="container">
    <h2 class="display h3 section-title">Who Katie works with</h2>
    <div class="grid-2 audience-grid" data-stagger>
      {[...audiences].reverse().map((audience) => (
        <a class={`audience card-link audience-${audience.visual}`} href={audience.href}>
          <div class="audience-image" aria-hidden="true">
            <img src={audience.image} alt="" loading="lazy" />
          </div>
          <div class="audience-body">
            <span class="audience-icon" aria-hidden="true">
              <svg viewBox="0 0 32 32" fill="none">
                <circle cx="16" cy="10" r="4.8" stroke="currentColor" stroke-width="1.4" />
                <path d="M7 27c1.2-5 4.2-8 9-8s7.8 3 9 8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
              </svg>
            </span>
            <h3 class="display eyeless">{audience.title}</h3>
            <p>{audience.summary}</p>
            <ul>
              {audience.pains.map((pain) => <li>{pain}</li>)}
            </ul>
            <span class="arrow-link">
              {audience.visual === 'founder' ? 'Coaching for founders' : 'Coaching for solo marketers'}
              <IconArrow />
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .section-title {
    margin: 0 0 36px;
    text-align: center;
  }

  .audience-grid {
    gap: 18px;
  }

  .audience {
    display: grid;
    grid-template-columns: minmax(160px, 0.56fr) minmax(0, 1fr);
    min-height: 330px;
    border: 1px solid var(--color-line);
    background: var(--color-white);
    text-align: left;
  }

  .audience-founder {
    background: linear-gradient(135deg, #fffefb 0%, #eff4fa 100%);
  }

  .audience-solo {
    background: linear-gradient(135deg, #fffefb 0%, #faf1ef 100%);
  }

  .audience-image {
    overflow: hidden;
    min-height: 100%;
    border-right: 1px solid var(--color-line);
  }

  .audience-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .audience-body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(26px, 4vw, 42px);
  }

  .audience-icon {
    width: 38px;
    height: 38px;
    margin-bottom: 22px;
    color: var(--color-navy);
  }

  .audience-founder .audience-icon {
    color: var(--color-blue);
  }

  .audience-solo .audience-icon {
    color: var(--color-burgundy);
  }

  h3 {
    font-size: clamp(1.75rem, 2.3vw, 2.35rem);
  }

  p {
    max-width: 360px;
    margin: 16px 0 18px;
    color: var(--color-muted);
  }

  ul {
    display: grid;
    gap: 8px;
    margin: 0 0 24px;
    padding: 0;
    color: var(--color-muted);
    font-size: 0.94rem;
    list-style: none;
  }

  li {
    padding-left: 18px;
    position: relative;
  }

  li::before {
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: var(--color-copper);
    color: var(--color-copper);
    content: "";
  }

  @media (max-width: 980px) {
    .audience {
      grid-template-columns: 1fr;
    }

    .audience-image {
      aspect-ratio: 1.8 / 1;
      border-right: 0;
      border-bottom: 1px solid var(--color-line);
    }
  }
</style>
