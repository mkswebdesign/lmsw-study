---
import { faqs } from '@data/site';

interface Props {
  limit?: number;
}

const { limit } = Astro.props;
const groups = limit ? faqs.map((group) => ({ ...group, items: group.items.slice(0, limit) })) : faqs;
---

<div class="faq-groups">
  {groups.map((group) => (
    <section class="faq-group">
      <h2 class="display eyeless">{group.category}</h2>
      <div class="items">
        {group.items.map((item) => (
          <details data-animate-details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </section>
  ))}
</div>

<style>
  .faq-groups {
    display: grid;
    gap: 42px;
  }

  .faq-group {
    display: grid;
    grid-template-columns: minmax(220px, 0.35fr) minmax(0, 1fr);
    gap: 40px;
    border-top: 1px solid var(--color-line);
    padding-top: 32px;
  }

  h2 {
    font-size: clamp(1.65rem, 2.2vw, 2.25rem);
  }

  details {
    border-bottom: 1px solid var(--color-line);
    padding: 0 0 22px;
  }

  details + details {
    padding-top: 22px;
  }

  summary {
    cursor: pointer;
    font-weight: 750;
    color: var(--color-ink);
    transition: color var(--motion-hover) var(--motion-ease);
  }

  summary:hover,
  summary:focus-visible {
    color: var(--color-copper);
  }

  p {
    margin: 14px 0 0;
    color: var(--color-muted);
  }

  @media (prefers-reduced-motion: no-preference) {
    details[open] p {
      animation: faq-answer-in 180ms var(--motion-ease) both;
    }

    @keyframes faq-answer-in {
      from {
        opacity: 0;
        filter: blur(3px);
      }

      to {
        opacity: 1;
        filter: blur(0);
      }
    }
  }

  @media (max-width: 740px) {
    .faq-group {
      grid-template-columns: 1fr;
      gap: 18px;
    }
  }
</style>
