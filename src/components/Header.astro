---
import { ctas, site } from '@data/site';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const normalized = href.replace(/\/$/, '') || '/';
  return currentPath === normalized || (normalized !== '/' && currentPath.startsWith(normalized));
};
---

<header class="site-header" aria-label="Primary navigation">
  <div class="header-inner">
    <a class="brand header-logo-link" href="/" aria-label="Katie Mayes home">
      <img class="brand-logo header-logo" src="/assets/katie-mayes/km-logo.png" alt={site.name} />
    </a>
    <nav class="nav-links" aria-label="Main">
      {site.nav.map((item) => <a class:list={{ active: isActive(item.href) }} href={item.href}>{item.label}</a>)}
    </nav>
    <a class="header-cta" href={ctas.primary.href}>{ctas.primary.label}</a>
    <details class="mobile-menu">
      <summary aria-label="Open navigation">
        <span>Menu</span>
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
          <path d="M5 7h14M5 12h14M5 17h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg>
      </summary>
      <nav aria-label="Mobile">
        {site.nav.map((item) => <a class:list={{ active: isActive(item.href) }} href={item.href}>{item.label}</a>)}
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgb(245 245 243 / 92%);
    border-bottom: 1px solid var(--color-line);
    backdrop-filter: blur(18px);
  }

  .header-inner {
    width: 100%;
    min-height: 86px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: clamp(140px, 12vw, 176px) minmax(0, 1fr) auto;
    gap: 30px;
    align-items: center;
    padding: 0 clamp(22px, 6vw, 76px) 0 clamp(22px, 4vw, 56px);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    width: 100%;
    min-width: 0;
  }

  .brand img {
    display: block;
    width: 100%;
    height: auto;
  }

  .nav-links {
    display: flex;
    justify-content: center;
    gap: clamp(16px, 3vw, 34px);
    font-size: 0.88rem;
    font-weight: 650;
  }

  .nav-links a {
    padding: 26px 0;
    color: var(--color-muted);
    border-bottom: 2px solid transparent;
  }

  .nav-links a:hover,
  .nav-links a:focus-visible,
  .nav-links a.active {
    color: var(--color-ink);
    border-bottom-color: var(--color-copper);
  }

  .header-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 11px 22px;
    background: var(--color-burgundy);
    color: var(--color-white);
    font-size: 0.86rem;
    font-weight: 750;
  }

  .header-cta:hover,
  .header-cta:focus-visible {
    background: var(--color-burgundy-dark);
  }

  .mobile-menu {
    display: none;
    position: relative;
    justify-self: end;
  }

  .mobile-menu summary {
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    border: 1px solid var(--color-line);
    cursor: pointer;
    font-size: 0.82rem;
    font-weight: 750;
    list-style: none;
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .mobile-menu svg {
    width: 18px;
    height: 18px;
  }

  .mobile-menu nav {
    position: absolute;
    right: 0;
    top: calc(100% + 10px);
    z-index: 30;
    display: grid;
    min-width: 210px;
    padding: 12px;
    background: var(--color-white);
    border: 1px solid var(--color-line);
    box-shadow: var(--shadow-soft);
  }

  .mobile-menu nav a {
    padding: 9px 8px;
    color: var(--color-muted);
    font-size: 0.9rem;
    font-weight: 700;
  }

  .mobile-menu nav a:hover,
  .mobile-menu nav a:focus-visible,
  .mobile-menu nav a.active {
    color: var(--color-ink);
  }

  @media (max-width: 920px) {
    .header-inner {
      grid-template-columns: clamp(138px, 24vw, 170px) auto;
      min-height: auto;
      padding-block: 15px;
    }

    .nav-links {
      grid-column: 1 / -1;
      justify-content: flex-start;
      overflow-x: auto;
      padding-bottom: 4px;
    }

    .nav-links a {
      padding: 8px 0;
      white-space: nowrap;
    }
  }

  @media (max-width: 760px) {
    .header-inner {
      grid-template-columns: 138px 1fr auto;
    }

    .nav-links {
      display: none;
    }

    .mobile-menu {
      display: block;
    }
  }

  @media (max-width: 560px) {
    .header-inner {
      grid-template-columns: 138px 1fr;
      padding-inline: 20px;
      gap: 12px;
    }

    .header-cta {
      display: none;
    }
  }
</style>
