---
import { trustPoints } from '@data/site';
---

<section class="section white trust-section" data-reveal="section">
  <div class="container">
    <h2 class="display h3 eyeless">What changes when the thinking gets clearer</h2>
    <div class="grid-3 trust-grid">
      {trustPoints.map((point, index) => (
        <div class="trust-card">
          <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <h3 class="display eyeless">{point.title}</h3>
          <p>{point.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  h2 {
    margin-bottom: 34px;
    text-align: center;
  }

  .trust-grid {
    gap: 18px;
  }

  .trust-card {
    min-height: 260px;
    border: 1px solid var(--color-line);
    padding: 30px;
    background: linear-gradient(180deg, var(--color-white) 0%, #f4f3ed 100%);
  }

  .trust-card span {
    display: block;
    margin-bottom: 48px;
    color: var(--color-copper);
    font-weight: 800;
  }

  h3 {
    font-size: clamp(1.5rem, 2vw, 2rem);
  }

  p {
    margin: 18px 0 0;
    color: var(--color-muted);
  }

  @media (max-width: 860px) {
    .trust-card {
      min-height: auto;
    }

    .trust-card span {
      margin-bottom: 24px;
    }
  }
</style>
