---
import { ctas, site } from '@data/site';
---
<footer class="footer">
  <div class="container footer-grid">
    <div>
      <a class="brand" href="/" aria-label="Katie Mayes home"><img src="/assets/katie-mayes/km-logo.png" alt={site.name} /></a>
      <p>Clear messaging. Focused strategy. Whoever you're marketing for.</p>
    </div>
    <nav aria-label="Footer">
      <div class="footer-links">
        <h2>Explore</h2>
        {site.nav.filter((item) => !['/for-founders', '/for-solo-marketers'].includes(item.href)).map((item) => <a href={item.href}>{item.label}</a>)}
      </div>
      <div class="footer-links">
        <h2>Work with Katie</h2>
        <a href="/for-solo-marketers">Solo Marketers</a>
        <a href="/for-founders">Founders</a>
        <a href={ctas.primary.href}>{ctas.primary.label} <span aria-hidden="true">&nearr;</span></a>
      </div>
    </nav>
  </div>
  <div class="container footer-bottom">&copy; {new Date().getFullYear()} {site.name} <a href="/terms/">Terms &amp; Conditions</a> <a href="/privacy/">Privacy Notice</a></div>
</footer>
<style>
  .footer { padding: 0 0 24px; background: var(--color-navy); color: var(--color-white); }
  .footer-grid { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 64px; align-items: start; border-top: 1px solid rgb(255 254 251 / 14%); padding-top: 48px; }
  .brand { display: inline-flex; width: 190px; margin-bottom: 18px; }
  .brand img { width: 100%; height: auto; filter: brightness(0) invert(1) grayscale(1); }
  p { max-width: 340px; margin: 0; color: rgb(255 254 251 / 72%); }
  nav { display: grid; grid-template-columns: repeat(2, auto); gap: 24px 64px; font-size: 0.92rem; font-weight: 650; }
  .footer-links { display: grid; align-content: start; gap: 12px; }
  h2 { margin: 0 0 6px; color: rgb(255 254 251 / 52%); font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; }
  nav a { color: rgb(255 254 251 / 78%); }
  nav a:hover, nav a:focus-visible { color: var(--color-white); text-decoration: underline; text-underline-offset: 5px; }
  .footer-bottom a { margin-left: 20px; text-decoration: underline; }
  .footer-bottom { margin-top: 48px; font-size: 0.75rem; color: rgb(255 254 251 / 52%); }
  @media (max-width: 700px) { .footer-grid { grid-template-columns: 1fr; gap: 36px; } nav { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; } }
</style>
