---
import InquiryForm from '@components/InquiryForm.astro';
import PageIntro from '@components/PageIntro.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
---
<BaseLayout title="Contact | Katie Mayes">
  <PageIntro title="Contact Katie Mayes." lede="Have a question about working together? Tell Katie a little about what you need. She will reply personally within 2 business days." showActions={false} />
  <section class="section sage-wash">
    <div class="container contact-form"><InquiryForm source="contact" /></div>
  </section>
</BaseLayout>
<style>.contact-form { max-width: 860px; }</style>
